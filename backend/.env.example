# Django Settings
DEBUG=True
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
ENVIRONMENT=development

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=business_db
DB_USER=postgres
